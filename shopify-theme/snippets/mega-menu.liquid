{% comment %}
  Accepts: link (a linklist link, possibly with nested .links for a mega panel)
{% endcomment %}
{%- if link.links != blank -%}
  <div class="nav-item">
    <a href="{{ link.url }}" class="header-link">{{ link.title }}</a>
    <div class="mega-panel bg-[var(--cream)] border border-[var(--brown-500)]/15 shadow-2xl p-7 w-56 flex flex-col gap-3 text-[var(--brown-700)] normal-case tracking-normal text-sm">
      {%- for child_link in link.links -%}
        <a href="{{ child_link.url }}" class="hover:text-[var(--matcha-700)]">{{ child_link.title }}</a>
      {%- endfor -%}
    </div>
  </div>
{%- else -%}
  <a href="{{ link.url }}" class="header-link">{{ link.title }}</a>
{%- endif -%}
