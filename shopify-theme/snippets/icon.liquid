{% comment %}
  Minimal line-icon set (24x24, stroke-based) so the storefront reads as a
  crafted, coherent system instead of mixed emoji. Usage:
  {% render 'icon', name: 'search', class: 'w-5 h-5' %}
{% endcomment %}
{%- assign icon_class = class | default: 'w-5 h-5' -%}
<svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="10.5" cy="10.5" r="6.5"></circle>
      <line x1="20" y1="20" x2="15.3" y2="15.3"></line>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="3.6"></circle>
      <path d="M4.5 20c1.4-3.6 4.4-5.4 7.5-5.4s6.1 1.8 7.5 5.4"></path>
    {%- when 'heart' -%}
      <path d="M12 20.2s-7-4.4-9.3-8.5C1.3 8.8 2.2 5.6 5.1 4.4c2.3-1 4.7 0 6.9 2.6 2.2-2.6 4.6-3.6 6.9-2.6 2.9 1.2 3.8 4.4 2.4 7.3-2.3 4.1-9.3 8.5-9.3 8.5z"></path>
    {%- when 'heart-filled' -%}
      <path d="M12 20.2s-7-4.4-9.3-8.5C1.3 8.8 2.2 5.6 5.1 4.4c2.3-1 4.7 0 6.9 2.6 2.2-2.6 4.6-3.6 6.9-2.6 2.9 1.2 3.8 4.4 2.4 7.3-2.3 4.1-9.3 8.5-9.3 8.5z" fill="currentColor"></path>
    {%- when 'bag' -%}
      <path d="M7 8V6a5 5 0 0 1 10 0v2"></path>
      <rect x="4" y="8" width="16" height="12.5" rx="1"></rect>
    {%- when 'coffee' -%}
      <path d="M4.5 9.5h12v6a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4v-6z"></path>
      <path d="M16.5 10.5H18a2.4 2.4 0 0 1 0 4.8h-1.5"></path>
      <path d="M8 5.2c0 1-1 1-1 2M11.5 5.2c0 1-1 1-1 2"></path>
    {%- when 'leaf' -%}
      <path d="M5 19c8-1 12.5-6 13-13-8 .5-13 5-13 13z"></path>
      <path d="M5.5 18.5 15 9"></path>
    {%- when 'gift' -%}
      <rect x="4" y="9.5" width="16" height="10.5" rx="0.6"></rect>
      <path d="M4 13h16"></path>
      <path d="M12 9.5v10.5"></path>
      <path d="M12 9.5c-1-2.6-3-3.5-4.4-2.6-1.3.8-.9 2.6 4.4 2.6zM12 9.5c1-2.6 3-3.5 4.4-2.6 1.3.8.9 2.6-4.4 2.6z"></path>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M4 12h16M12 4c2.4 2.2 3.6 5 3.6 8s-1.2 5.8-3.6 8c-2.4-2.2-3.6-5-3.6-8s1.2-5.8 3.6-8z"></path>
    {%- when 'recycle' -%}
      <circle cx="12" cy="12" r="8.2"></circle>
      <path d="M9 8.6h4.6l-1.4-1.6M14.9 15.4l-2.3 3.9-2.3-3.9M8.6 9.5l-2.3 3.9 2.3 1.3"></path>
    {%- when 'truck' -%}
      <rect x="2.5" y="8" width="11" height="8" rx="0.5"></rect>
      <path d="M13.5 11h3.6l3.4 3v2H13.5z"></path>
      <circle cx="6.5" cy="17.6" r="1.5"></circle>
      <circle cx="17" cy="17.6" r="1.5"></circle>
    {%- when 'star' -%}
      <path d="M12 3.5l2.5 5.4 5.8.6-4.3 4 1.2 5.9L12 16.4l-5.2 3-1.2-5.9-4.3-4 5.8-.6z"></path>
    {%- when 'close' -%}
      <line x1="5" y1="5" x2="19" y2="19"></line>
      <line x1="19" y1="5" x2="5" y2="19"></line>
    {%- when 'menu' -%}
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    {%- when 'chevron-right' -%}
      <path d="M9 5l7 7-7 7"></path>
  {%- endcase -%}
</svg>
