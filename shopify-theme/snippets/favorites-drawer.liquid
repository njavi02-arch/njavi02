<aside id="favorites-panel" class="side-panel" aria-label="{{ 'general.favorites.title' | t }}">
  <div class="flex items-center justify-between p-7 border-b border-[var(--brown-500)]/15">
    <h3 class="font-display text-2xl text-[var(--brown-900)] italic">{{ 'general.favorites.title' | t }}</h3>
    <button class="panel-close text-2xl leading-none text-[var(--brown-700)]" aria-label="{{ 'general.favorites.close' | t }}">&times;</button>
  </div>
  <div id="favorites-items" class="flex-1 overflow-y-auto p-7 flex flex-col gap-6"></div>
</aside>
