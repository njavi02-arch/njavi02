<section class="py-32 px-6 md:px-10 bg-[var(--cream)]">
  <article class="max-w-3xl mx-auto">
    <div class="text-center mb-12 reveal">
      <div class="gold-rule mx-auto mb-6"></div>
      <span class="eyebrow text-xs uppercase text-[var(--brown-500)]">{{ article.published_at | date: '%d %b %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</span>
      <h1 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] mt-4 italic">{{ article.title }}</h1>
    </div>

    {%- if article.image -%}
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | default: article.title | escape }}" class="w-full aspect-[16/9] object-cover mb-12" width="{{ article.image.width }}" height="{{ article.image.height }}">
    {%- endif -%}

    <div class="prose prose-lg text-[var(--brown-700)] leading-relaxed font-light max-w-none">
      {{ article.content }}
    </div>

    {%- if blog.comments_enabled? -%}
      <div class="mt-16 pt-10 border-t border-[var(--brown-500)]/15">
        <h2 class="font-display text-2xl text-[var(--brown-900)] mb-6 italic">{{ 'general.article.comments' | t: count: article.comments_count }}</h2>
        {%- for comment in article.comments -%}
          <div class="mb-6 pb-6 border-b border-[var(--brown-500)]/10">
            <p class="text-sm text-[var(--brown-900)]">{{ comment.author }}</p>
            <p class="text-sm text-[var(--brown-700)] font-light mt-1">{{ comment.content }}</p>
          </div>
        {%- endfor -%}
        {%- form 'new_comment', article -%}
          {{ form.errors | default_errors }}
          {%- if form.posted_successfully? -%}
            <p class="text-sm text-[var(--matcha-700)] mb-4">{{ 'general.article.comment_posted' | t }}</p>
          {%- endif -%}
          <div class="flex flex-col gap-3">
            <input type="text" name="comment[author]" placeholder="{{ 'general.article.comment_name' | t }}" required class="px-4 py-3 border border-[var(--brown-500)]/30 bg-transparent focus:outline-none text-sm">
            <input type="email" name="comment[email]" placeholder="tu@email.com" required class="px-4 py-3 border border-[var(--brown-500)]/30 bg-transparent focus:outline-none text-sm">
            <textarea name="comment[body]" rows="4" placeholder="{{ 'general.article.comment_body' | t }}" required class="px-4 py-3 border border-[var(--brown-500)]/30 bg-transparent focus:outline-none text-sm"></textarea>
            <button type="submit" class="bg-[var(--brown-900)] text-[var(--cream)] py-3 text-xs tracking-[0.2em] uppercase hover:bg-[var(--brown-700)] self-start px-8">{{ 'general.article.comment_submit' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="mt-16 text-center">
      <a href="{{ blog.url }}" class="btn-outline text-[var(--brown-900)] px-9 py-4 text-xs tracking-[0.2em] uppercase">{{ 'general.article.back_to_blog' | t }}</a>
    </div>
  </article>
</section>

{% schema %}
{
  "name": "Página de artículo",
  "settings": []
}
{% endschema %}
