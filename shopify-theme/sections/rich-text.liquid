<section class="py-24 px-6 md:px-10 bg-[var(--cream)]">
  <div class="max-w-3xl mx-auto text-center reveal">
    <div class="gold-rule mx-auto mb-6"></div>
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow text-xs uppercase text-[var(--gold)] block mb-3">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="font-display text-3xl md:text-4xl text-[var(--brown-900)] italic mb-5">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="text-[var(--brown-700)] leading-relaxed font-light max-w-xl mx-auto">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <a href="{{ section.settings.button_url }}" class="inline-block mt-8 border border-[var(--brown-500)]/40 px-8 py-3.5 text-xs tracking-[0.2em] uppercase text-[var(--brown-900)] hover:bg-[var(--cream-deep)] transition-colors">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto enriquecido",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Un título para tu texto" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Usá esta sección para un mensaje corto: una cita, un anuncio o una aclaración destacada en cualquier página.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_url", "label": "Enlace del botón" }
  ],
  "presets": [
    { "name": "Texto enriquecido" }
  ]
}
{% endschema %}
