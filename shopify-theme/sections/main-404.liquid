<section class="py-32 px-6 md:px-10 bg-[var(--cream)] min-h-[60vh] flex items-center">
  <div class="max-w-lg mx-auto text-center">
    <div class="gold-rule mx-auto mb-6"></div>
    <span class="eyebrow text-xs uppercase text-[var(--gold)]">404</span>
    <h1 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] mt-4 mb-6 italic">{{ 'general.404.heading' | t }}</h1>
    <p class="text-[var(--brown-700)] font-light mb-10">{{ 'general.404.text' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn-outline text-[var(--brown-900)] px-9 py-4 text-xs tracking-[0.2em] uppercase">{{ 'general.404.back_home' | t }}</a>
  </div>
</section>

