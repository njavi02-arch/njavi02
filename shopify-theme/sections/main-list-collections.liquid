<section class="py-32 px-6 md:px-10 bg-[var(--cream-deep)]">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 reveal">
      <div class="gold-rule mx-auto mb-6"></div>
      <h1 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] italic">{{ 'general.list_collections.heading' | t }}</h1>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a href="{{ collection.url }}" class="narrative-card block bg-[var(--cream)] p-7">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" class="w-full aspect-[4/3] object-cover mb-5" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">
            {%- endif -%}
            <h3 class="font-display text-xl text-[var(--brown-900)] italic">{{ collection.title }}</h3>
            <p class="text-xs text-[var(--brown-500)] mt-2">{{ collection.all_products_count }} {{ 'general.list_collections.products' | t }}</p>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Todas las colecciones",
  "settings": []
}
{% endschema %}
