<section class="py-32 px-6 md:px-10 bg-[var(--cream-deep)]">
  <div class="max-w-7xl mx-auto flex flex-col gap-28">
    {%- for block in section.blocks -%}
      <div class="grid md:grid-cols-2 gap-14 items-center reveal" {{ block.shopify_attributes }}>
        <div class="{% if block.settings.image_position == 'right' %}md:order-2{% endif %} aspect-[4/3] overflow-hidden rounded-2xl" style="box-shadow: 0 30px 60px -30px rgba(74,44,32,0.4);">
          {%- if block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" class="w-full h-full object-cover" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
          {%- else -%}
            <div class="w-full h-full bg-[var(--beige)]"></div>
          {%- endif -%}
        </div>
        <div class="{% if block.settings.image_position == 'right' %}md:order-1{% endif %}">
          <div class="gold-rule mb-6"></div>
          <h3 class="font-display text-3xl md:text-4xl text-[var(--brown-900)] mb-5 italic">{{ block.settings.heading }}</h3>
          <p class="text-[var(--brown-700)] leading-relaxed font-light max-w-md">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Narrativa de marca",
  "settings": [],
  "blocks": [
    {
      "type": "story",
      "name": "Bloque de historia",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Nuestro café tiene una historia" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Seleccionamos cada grano pensando en una experiencia única, desde el cafetal hasta tu taza." },
        {
          "type": "select",
          "id": "image_position",
          "label": "Posición de la imagen",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Narrativa de marca",
      "blocks": [
        { "type": "story", "settings": { "heading": "Nuestro café tiene una historia", "text": "Seleccionamos cada grano pensando en una experiencia única, desde el cafetal hasta tu taza.", "image_position": "left" } },
        { "type": "story", "settings": { "heading": "El ritual del matcha, llevado a otro nivel", "text": "Molienda de piedra y una ceremonia pensada para pausar, respirar y disfrutar el momento.", "image_position": "right" } }
      ]
    }
  ]
}
{% endschema %}
