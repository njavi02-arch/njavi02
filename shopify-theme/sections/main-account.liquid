<section class="py-32 px-6 md:px-10 bg-[var(--cream)] min-h-[70vh]">
  <div class="max-w-4xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12 reveal">
      <div>
        <div class="gold-rule mb-6"></div>
        <h1 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] italic">{{ 'customer.account.greeting' | t: name: customer.first_name }}</h1>
        <p class="text-sm text-[var(--brown-500)] mt-2">{{ customer.email }}</p>
      </div>
      <div class="flex gap-3">
        <a href="{{ routes.account_addresses_url }}" class="border border-[var(--brown-500)]/40 px-5 py-3 text-xs tracking-[0.2em] uppercase text-[var(--brown-900)] hover:bg-[var(--cream-deep)] transition-colors">{{ 'customer.account.addresses' | t }}</a>
        <a href="{{ routes.account_logout_url }}" class="border border-[var(--brown-500)]/40 px-5 py-3 text-xs tracking-[0.2em] uppercase text-[var(--brown-900)] hover:bg-[var(--cream-deep)] transition-colors">{{ 'customer.account.logout' | t }}</a>
      </div>
    </div>

    <h2 class="font-display text-2xl text-[var(--brown-900)] italic mb-6">{{ 'customer.account.orders_title' | t }}</h2>

    {%- paginate customer.orders by 10 -%}
      {%- if customer.orders.size > 0 -%}
        <div class="overflow-x-auto border border-[var(--brown-500)]/15">
          <table class="w-full text-sm text-left">
            <thead>
              <tr class="border-b border-[var(--brown-500)]/15 text-xs uppercase tracking-wide text-[var(--brown-500)]">
                <th class="px-5 py-4 font-normal">{{ 'customer.account.order_number' | t }}</th>
                <th class="px-5 py-4 font-normal">{{ 'customer.account.order_date' | t }}</th>
                <th class="px-5 py-4 font-normal">{{ 'customer.account.order_payment' | t }}</th>
                <th class="px-5 py-4 font-normal">{{ 'customer.account.order_fulfillment' | t }}</th>
                <th class="px-5 py-4 font-normal text-right">{{ 'customer.account.order_total' | t }}</th>
                <th class="px-5 py-4 font-normal"></th>
              </tr>
            </thead>
            <tbody class="text-[var(--brown-700)] font-light">
              {%- for order in customer.orders -%}
                <tr class="border-b border-[var(--brown-500)]/10 last:border-0">
                  <td class="px-5 py-4">{{ order.name }}</td>
                  <td class="px-5 py-4">{{ order.created_at | date: '%d/%m/%Y' }}</td>
                  <td class="px-5 py-4">{{ order.financial_status_label }}</td>
                  <td class="px-5 py-4">{{ order.fulfillment_status_label }}</td>
                  <td class="px-5 py-4 text-right">{{ order.total_price | money }}</td>
                  <td class="px-5 py-4 text-right">
                    <a href="{{ order.customer_url }}" class="text-[var(--matcha-700)] underline">{{ 'customer.account.view_order' | t }}</a>
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="flex justify-center gap-4 mt-10 text-sm" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="text-[var(--brown-700)] hover:text-[var(--matcha-700)]">&larr;</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="text-[var(--brown-700)] hover:text-[var(--matcha-700)]">{{ part.title }}</a>
              {%- else -%}
                <span class="text-[var(--brown-900)]">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="text-[var(--brown-700)] hover:text-[var(--matcha-700)]">&rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="text-[var(--brown-500)] text-sm border border-[var(--brown-500)]/15 px-6 py-10 text-center">{{ 'customer.account.no_orders' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Mi cuenta",
  "settings": []
}
{% endschema %}
