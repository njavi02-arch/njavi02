<section id="reviews" class="py-32 px-6 md:px-10 bg-[var(--cream)] overflow-hidden" data-reviews-section>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-6 reveal">
      <div class="gold-rule mx-auto mb-6"></div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow text-xs uppercase text-[var(--matcha-700)]">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] mt-3 italic">{{ section.settings.heading }}</h2>
      <p data-reviews-average class="text-sm text-[var(--brown-700)] mt-5"></p>
      {%- if section.settings.note != blank -%}
        <p class="text-xs text-[var(--brown-500)] mt-2">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    <div class="flex items-center gap-6 mt-16 reveal">
      <button data-reviews-hold class="review-hold-btn hidden sm:flex" aria-label="{{ 'general.reviews.hold_hint' | t }}">←</button>
      <div class="reviews-viewport flex-1">
        <div class="reviews-track"></div>
      </div>
    </div>

    <p class="text-center text-xs text-[var(--brown-500)] mt-3 sm:hidden">{{ 'general.reviews.swipe_hint' | t }}</p>
    <p class="hidden sm:block text-center text-xs text-[var(--brown-500)] mt-4">{{ 'general.reviews.hold_hint' | t }}</p>

    <div data-reviews-dots class="flex justify-center gap-2 mt-8"></div>
  </div>

  <script type="application/json" data-reviews-json>
    [
      {%- for block in section.blocks -%}
        {
          "name": {{ block.settings.name | json }},
          "initials": {{ block.settings.initials | json }},
          "rating": {{ block.settings.rating | json }},
          "text": {{ block.settings.text | json }},
          "date": {{ block.settings.date | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Carrusel de reseñas",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Confianza real" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dice nuestra comunidad" },
    { "type": "textarea", "id": "note", "label": "Nota", "default": "Para reseñas verificadas conectá una app de reviews (Judge.me, Loox) — estos bloques son editables a mano desde el editor de temas." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "María G." },
        { "type": "text", "id": "initials", "label": "Iniciales", "default": "MG" },
        { "type": "range", "id": "rating", "label": "Valoración", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "El vaso térmico mantiene el café caliente toda la mañana y el diseño es precioso." },
        { "type": "text", "id": "date", "label": "Fecha (AAAA-MM-DD)", "default": "2026-06-02" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Carrusel de reseñas",
      "blocks": [
        { "type": "review", "settings": { "name": "María G.", "initials": "MG", "rating": 5, "date": "2026-06-02", "text": "El vaso térmico mantiene el café caliente toda la mañana y el diseño es precioso." } },
        { "type": "review", "settings": { "name": "Javier R.", "initials": "JR", "rating": 5, "date": "2026-05-18", "text": "Se nota la calidad artesanal en cada detalle. Ya pedí el pack de regalo para toda mi familia." } },
        { "type": "review", "settings": { "name": "Sofía L.", "initials": "SL", "rating": 5, "date": "2026-06-21", "text": "La experiencia de compra se siente premium de principio a fin. Volvería a comprar sin dudarlo." } },
        { "type": "review", "settings": { "name": "Diego F.", "initials": "DF", "rating": 4, "date": "2026-04-30", "text": "Muy contento con la compra, el producto llegó rápido y la calidad supera mis expectativas." } }
      ]
    }
  ]
}
{% endschema %}
