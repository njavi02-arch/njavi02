<section class="py-32 px-6 md:px-10 bg-[var(--cream)] min-h-[50vh]">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-12 reveal">
      <div class="gold-rule mx-auto mb-6"></div>
      <h1 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] italic">{{ page.title }}</h1>
    </div>
    <div class="prose prose-lg text-[var(--brown-700)] leading-relaxed font-light max-w-none">
      {{ page.content }}
