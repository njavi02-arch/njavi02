<section class="py-32 px-6 md:px-10 bg-[var(--cream)] min-h-[70vh]">
  <div class="max-w-3xl mx-auto">
    <a href="{{ routes.account_url }}" class="text-xs uppercase tracking-[0.2em] text-[var(--brown-700)] underline">{{ 'customer.order.back_to_account' | t }}</a>

    <div class="mt-8 mb-10 reveal">
      <div class="gold-rule mb-6"></div>
      <h1 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] italic">{{ 'customer.order.title' | t: name: order.name }}</h1>
      {%- if order.cancelled -%}
        <p class="text-sm text-[var(--brown-500)] mt-2">{{ 'customer.order.cancelled' | t: date: order.cancelled_at | date: '%d/%m/%Y' }}</p>
      {%- else -%}
        <p class="text-sm text-[var(--brown-500)] mt-2">{{ 'customer.order.date' | t: date: order.created_at | date: '%d/%m/%Y' }}</p>
      {%- endif -%}
    </div>

    <div class="grid sm:grid-cols-2 gap-3 text-sm mb-10">
      <span class="border border-[var(--brown-500)]/20 px-4 py-3 text-[var(--brown-700)]">{{ 'customer.order.payment_status' | t }}: <strong class="text-[var(--brown-900)]">{{ order.financial_status_label }}</strong></span>
      <span class="border border-[var(--brown-500)]/20 px-4 py-3 text-[var(--brown-700)]">{{ 'customer.order.fulfillment_status' | t }}: <strong class="text-[var(--brown-900)]">{{ order.fulfillment_status_label }}</strong></span>
    </div>

    <div class="overflow-x-auto border border-[var(--brown-500)]/15 mb-10">
      <table class="w-full text-sm text-left">
        <thead>
          <tr class="border-b border-[var(--brown-500)]/15 text-xs uppercase tracking-wide text-[var(--brown-500)]">
            <th class="px-5 py-4 font-normal">{{ 'customer.order.product' | t }}</th>
            <th class="px-5 py-4 font-normal text-right">{{ 'customer.order.price' | t }}</th>
            <th class="px-5 py-4 font-normal text-right">{{ 'customer.order.quantity' | t }}</th>
            <th class="px-5 py-4 font-normal text-right">{{ 'customer.order.total' | t }}</th>
          </tr>
        </thead>
        <tbody class="text-[var(--brown-700)] font-light">
          {%- for line_item in order.line_items -%}
            <tr class="border-b border-[var(--brown-500)]/10 last:border-0">
              <td class="px-5 py-4">
                <a href="{{ line_item.product.url | default: '#' }}" class="text-[var(--brown-900)] hover:text-[var(--matcha-700)]">{{ line_item.title }}</a>
                {%- if line_item.variant.title != 'Default Title' %}<span class="block text-xs text-[var(--brown-500)]">{{ line_item.variant.title }}</span>{% endif -%}
              </td>
              <td class="px-5 py-4 text-right">{{ line_item.original_price | money }}</td>
              <td class="px-5 py-4 text-right">{{ line_item.quantity }}</td>
              <td class="px-5 py-4 text-right">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot class="text-[var(--brown-900)]">
          <tr class="border-t border-[var(--brown-500)]/15">
            <td colspan="3" class="px-5 py-3 text-right text-xs uppercase tracking-wide text-[var(--brown-500)]">{{ 'customer.order.subtotal' | t }}</td>
            <td class="px-5 py-3 text-right">{{ order.subtotal_price | money }}</td>
          </tr>
          {%- for shipping_line in order.shipping_lines -%}
            <tr>
              <td colspan="3" class="px-5 py-3 text-right text-xs uppercase tracking-wide text-[var(--brown-500)]">{{ 'customer.order.shipping' | t }}</td>
              <td class="px-5 py-3 text-right">{{ shipping_line.price | money }}</td>
            </tr>
          {%- endfor -%}
          {%- if order.total_discounts > 0 -%}
            <tr>
              <td colspan="3" class="px-5 py-3 text-right text-xs uppercase tracking-wide text-[var(--brown-500)]">{{ 'customer.order.discount' | t }}</td>
              <td class="px-5 py-3 text-right">-{{ order.total_discounts | money }}</td>
            </tr>
          {%- endif -%}
          {%- for tax_line in order.tax_lines -%}
            <tr>
              <td colspan="3" class="px-5 py-3 text-right text-xs uppercase tracking-wide text-[var(--brown-500)]">{{ 'customer.order.tax' | t }}</td>
              <td class="px-5 py-3 text-right">{{ tax_line.price | money }}</td>
            </tr>
          {%- endfor -%}
          <tr class="border-t border-[var(--brown-500)]/15">
            <td colspan="3" class="px-5 py-4 text-right text-sm font-medium">{{ 'customer.order.total' | t }}</td>
            <td class="px-5 py-4 text-right text-lg font-display italic">{{ order.total_price | money }}</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="grid sm:grid-cols-2 gap-8 text-sm">
      {%- if order.shipping_address -%}
        <div>
          <h2 class="text-xs uppercase tracking-wide text-[var(--brown-500)] mb-2">{{ 'customer.order.shipping_address' | t }}</h2>
          <p class="text-[var(--brown-700)] font-light leading-relaxed">{{ order.shipping_address | format_address }}</p>
        </div>
      {%- endif -%}
      {%- if order.billing_address -%}
        <div>
          <h2 class="text-xs uppercase tracking-wide text-[var(--brown-500)] mb-2">{{ 'customer.order.billing_address' | t }}</h2>
          <p class="text-[var(--brown-700)] font-light leading-relaxed">{{ order.billing_address | format_address }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Detalle de pedido",
  "settings": []
}
{% endschema %}
