<section id="blog" class="py-32 px-6 md:px-10 bg-[var(--cream-deep)]">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20 reveal">
      <div class="gold-rule mx-auto mb-6"></div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow text-xs uppercase text-[var(--matcha-700)]">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] mt-3 italic">{{ section.settings.heading }}</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {%- assign blog = section.settings.blog -%}
      {%- if blog -%}
        {%- for article in blog.articles limit: section.settings.articles_to_show -%}
          <a href="{{ article.url }}" class="blog-card bg-[var(--cream)] p-7">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 400 }}" alt="{{ article.image.alt | default: article.title | escape }}" class="w-full aspect-square object-cover mb-5" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}">
            {%- else -%}
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-full border border-[var(--gold)]/40 mb-5">{%- render 'icon', name: 'coffee', class: 'w-5 h-5 text-[var(--gold)]' -%}</span>
            {%- endif -%}
            <h3 class="font-display text-lg text-[var(--brown-900)] mb-2 italic">{{ article.title }}</h3>
            <p class="text-sm text-[var(--brown-700)] font-light">{{ article.excerpt_or_content | strip_html | truncate: 90 }}</p>
          </a>
        {%- else -%}
          <p class="col-span-full text-center text-[var(--brown-500)]">{{ 'general.blog.empty' | t }}</p>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog destacado",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño", "default": "Contenido" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Aprendé sobre café y matcha" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "articles_to_show", "label": "Artículos a mostrar", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Blog destacado" }]
}
{% endschema %}
