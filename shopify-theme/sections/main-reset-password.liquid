<section class="py-32 px-6 md:px-10 bg-[var(--cream)] min-h-[70vh]">
  <div class="max-w-md mx-auto">
    <div class="text-center mb-12 reveal">
      <div class="gold-rule mx-auto mb-6"></div>
      <h1 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] italic">{{ 'customer.reset_password.title' | t }}</h1>
      <p class="text-sm text-[var(--brown-500)] mt-3">{{ 'customer.reset_password.subtitle' | t: email: customer.email }}</p>
    </div>

    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="flex flex-col gap-4">
        <label class="text-xs uppercase tracking-wide text-[var(--brown-500)]">{{ 'customer.reset_password.password' | t }}
          <input type="password" name="customer[password]" autocomplete="new-password" required class="mt-1 w-full px-4 py-3 border border-[var(--brown-500)]/30 bg-transparent focus:outline-none focus:border-[var(--gold)]" placeholder="••••••••">
        </label>
        <label class="text-xs uppercase tracking-wide text-[var(--brown-500)]">{{ 'customer.reset_password.password_confirm' | t }}
          <input type="password" name="customer[password_confirmation]" autocomplete="new-password" required class="mt-1 w-full px-4 py-3 border border-[var(--brown-500)]/30 bg-transparent focus:outline-none focus:border-[var(--gold)]" placeholder="••••••••">
        </label>
        <button type="submit" class="bg-[var(--brown-900)] text-[var(--cream)] py-3.5 text-xs tracking-[0.2em] uppercase hover:bg-[var(--brown-700)] transition-colors mt-2">{{ 'customer.reset_password.submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Restablecer contraseña",
  "settings": []
}
{% endschema %}
