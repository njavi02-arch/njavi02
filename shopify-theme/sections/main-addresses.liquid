<section class="py-32 px-6 md:px-10 bg-[var(--cream)] min-h-[70vh]">
  <div class="max-w-3xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12 reveal">
      <div>
        <div class="gold-rule mb-6"></div>
        <h1 class="font-display text-4xl md:text-5xl text-[var(--brown-900)] italic">{{ 'customer.addresses.title' | t }}</h1>
      </div>
      <a href="{{ routes.account_url }}" class="text-xs uppercase tracking-[0.2em] text-[var(--brown-700)] underline">{{ 'customer.order.back_to_account' | t }}</a>
    </div>

    <details class="mb-10 border border-[var(--brown-500)]/15 p-6">
      <summary class="cursor-pointer text-xs uppercase tracking-wide text-[var(--brown-500)]">{{ 'customer.addresses.add_new' | t }}</summary>
      {%- form 'customer_address', customer.new_address -%}
        {{ form.errors | default_errors }}
        {%- render 'address-fields', form: form -%}
        <button type="submit" class="bg-[var(--brown-900)] text-[var(--cream)] py-3.5 px-6 text-xs tracking-[0.2em] uppercase hover:bg-[var(--brown-700)] transition-colors mt-4">{{ 'customer.addresses.save' | t }}</button>
      {%- endform -%}
    </details>

    {%- if customer.addresses.size > 0 -%}
      <div class="flex flex-col gap-6">
        {%- for address in customer.addresses -%}
          <div class="border border-[var(--brown-500)]/15 p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="text-sm text-[var(--brown-700)] font-light leading-relaxed">
                {{ address.first_name }} {{ address.last_name }}<br>
                {%- if address.company != blank -%}{{ address.company }}<br>{%- endif -%}
                {{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %}<br>
                {{ address.city }}{% if address.province != blank %}, {{ address.province }}{% endif %} {{ address.zip }}<br>
                {{ address.country }}
                {%- if address.phone != blank -%}<br>{{ address.phone }}{%- endif -%}
                {%- if address == customer.default_address -%}
                  <span class="inline-block mt-2 text-[10px] uppercase tracking-[0.2em] text-[var(--gold)] border border-[var(--gold)]/40 px-2 py-1">{{ 'customer.addresses.default' | t }}</span>
                {%- endif -%}
              </div>
              <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" onsubmit="return confirm('{{ 'customer.addresses.confirm_delete' | t }}');" class="shrink-0">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="text-xs text-[var(--brown-500)] underline">{{ 'customer.addresses.delete' | t }}</button>
              </form>
            </div>

            <details class="mt-4 pt-4 border-t border-[var(--brown-500)]/10">
              <summary class="cursor-pointer text-xs text-[var(--matcha-700)] underline">{{ 'customer.addresses.edit' | t }}</summary>
              {%- form 'customer_address', address -%}
                {{ form.errors | default_errors }}
                {%- render 'address-fields', form: form -%}
                <label class="flex items-center gap-2 text-xs text-[var(--brown-700)] mt-3">
                  <input type="checkbox" name="address[default]" value="1" {% if address == customer.default_address %}checked{% endif %}>
                  {{ 'customer.addresses.set_default' | t }}
                </label>
                <button type="submit" class="border border-[var(--brown-500)]/40 py-3 px-6 text-xs tracking-[0.2em] uppercase text-[var(--brown-900)] hover:bg-[var(--cream-deep)] transition-colors mt-4">{{ 'customer.addresses.save' | t }}</button>
              {%- endform -%}
            </details>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="text-[var(--brown-500)] text-sm border border-[var(--brown-500)]/15 px-6 py-10 text-center">{{ 'customer.addresses.none' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Direcciones",
  "settings": []
}
{% endschema %}
