<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4" defer="defer"></script>
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <style>
        :root {
            --cream: {{ settings.color_cream }};
            --brown-900: {{ settings.color_brown_900 }};
            --brown-700: {{ settings.color_brown_700 }};
            --gold: {{ settings.color_gold }};
        }
        body { background: var(--cream); color: var(--brown-900); font-family: 'Inter', sans-serif; font-weight: 300; }
    </style>
</head>

<body class="antialiased min-h-screen flex items-center justify-center px-6">
    <div class="max-w-md w-full text-center py-20">
        <span class="font-display text-3xl italic tracking-wide">{{ shop.name }}</span>
        <div class="gold-rule mx-auto my-6"></div>

        {% if password_page.header.message != blank %}
          <h1 class="font-display text-3xl italic mb-4">{{ password_page.header.message }}</h1>
        {% else %}
          <h1 class="font-display text-3xl italic mb-4">Muy pronto</h1>
        {% endif %}

        {% if password_page.header.text != blank %}
          <p class="text-sm text-[var(--brown-700)] font-light mb-10">{{ password_page.header.text }}</p>
        {% endif %}

        {% form 'storefront_password' %}
          {{ form.errors | default_errors }}
          <div class="flex flex-col sm:flex-row gap-3 justify-center mt-4">
            <input type="password" name="password" placeholder="{{ 'general.password_page.login_password_placeholder' | t }}" class="flex-1 max-w-sm px-5 py-3.5 text-[var(--brown-900)] bg-[var(--cream)] border border-[var(--brown-500)]/30 focus:outline-none">
            <button type="submit" class="btn-outline text-[var(--brown-900)] px-8 py-3.5 text-xs tracking-[0.2em] uppercase">{{ 'general.password_page.login_form_submit' | t }}</button>
          </div>
        {% endform %}

        {% if shop.email %}
          <p class="text-xs text-[var(--brown-700)] mt-10 font-light">{{ 'general.password_page.contact' | t }} {{ shop.email }}</p>
        {% endif %}

        {{ content_for_footer }}
    </div>
</body>

</html>
