# Copia este archivo como .env (NO lo subas a ningún sitio) y pega las URLs de webhook de tu servidor de Discord.
#
# OPCIÓN SENCILLA: rellena SOLO DISCORD_WEBHOOK_DEFAULT y TODO llegará a ese canal.
DISCORD_WEBHOOK_DEFAULT=

# OPCIÓN ORGANIZADA (recomendada). Las que dejes vacías usan DEFAULT.
# — Lo que hay que mirar sí o sí
DISCORD_WEBHOOK_LANZAMIENTOS=   # 📢 anuncios, fecha confirmada/cambiada, A LA VENTA, resumen diario 09:00
DISCORD_WEBHOOK_RAFFLES=        # 🎟️ raffle abierto, enlace nuevo, "cierra en 3 h"
DISCORD_WEBHOOK_RESTOCKS=       # 🔄 "Ha vuelto la EU 43" en lanzamientos vigilados
DISCORD_WEBHOOK_PINGS=          # 🔔 tus reglas personales (talla, marca, precio máx.) con mención de rol
# — Monitores por tienda
DISCORD_WEBHOOK_SNEAKERS=       # 👟 tiendas Shopify Europa
DISCORD_WEBHOOK_SNEAKERS_WORLD= # 🌎 EE. UU. / Australia
DISCORD_WEBHOOK_STREETWEAR=     # 👕 ropa
DISCORD_WEBHOOK_REBAJAS_30=     # 💸 ≥30 % de descuento
DISCORD_WEBHOOK_REBAJAS_60=     # 💸 ≥60 %
DISCORD_WEBHOOK_CHOLLOS=        # 🔥 Chollometro / Dealabs
DISCORD_WEBHOOK_RELEASES=       # 📆 calendario que edita el staff (config/releases.toml)
