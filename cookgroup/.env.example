# Copiar a .env (NO commitear). Pega aquí las URLs de webhook de tu servidor de Discord.
# Opción rápida para probar: rellena SOLO DISCORD_WEBHOOK_DEFAULT y todo llegará a ese canal.
DISCORD_WEBHOOK_DEFAULT=

# Opcional: un canal por tipo (si están vacías se usa DEFAULT)
DISCORD_WEBHOOK_SNEAKERS=
DISCORD_WEBHOOK_STREETWEAR=
DISCORD_WEBHOOK_CHOLLOS=
DISCORD_WEBHOOK_REBAJAS_30=
DISCORD_WEBHOOK_REBAJAS_60=
DISCORD_WEBHOOK_RELEASES=
DISCORD_WEBHOOK_PINGS=
