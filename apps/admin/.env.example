# Nunca uses NEXT_PUBLIC_ para estas dos: son secretas y solo deben usarse en el
# servidor (Server Components / Server Actions / Route Handlers).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# La anon key solo se usa server-side para verificar email/password en /login.
SUPABASE_ANON_KEY=tu-anon-key

# Secreto para firmar la cookie de sesión del panel admin (genera uno largo y aleatorio,
# p. ej. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
