# Copia este archivo a .env y rellena con las credenciales de tu proyecto Supabase
# (Project Settings → API). La anon key es pública por diseño: la protección real
# vive en las políticas RLS de supabase/migrations/0001_init.sql.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
